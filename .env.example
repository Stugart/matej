# =====================================================================
# Kutaj AI Core — environment variables
#
# Skopíruj na .env a doplň hodnoty. Súbor .env NIKDY necommituj do gitu.
# Na produkčnom serveri: /etc/kutaj/.env, vlastník root:kutaj, mód 0640.
# =====================================================================

# --- Aplikácia ---
APP_ENV=dev                                  # dev | prod
APP_BASE_URL=http://127.0.0.1:8000
APP_LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR

# Náhodný 32+ znakový reťazec: `openssl rand -hex 32`
APP_SECRET_KEY=

# --- Databáza (PostgreSQL 16 + pgvector) ---
# Async driver pre FastAPI; Alembic interne použije sync ekvivalent.
DATABASE_URL=postgresql+asyncpg://kutaj:kutaj_dev_only@127.0.0.1:5432/kutaj

# --- Redis (worker queue + cache) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Storage (audio + tmp) ---
# Adresár MIMO public webrootu. Na produkcii: /var/kutaj/audio a /var/kutaj/tmp.
STORAGE_ROOT=./storage/audio
TMP_ROOT=./storage/tmp

# --- Upload limity ---
MAX_AUDIO_UPLOAD_BYTES=209715200             # 200 MB hard limit
MAX_AUDIO_DURATION_SECONDS=1800              # 30 min hard limit
ALLOWED_AUDIO_MIME=audio/mpeg,audio/mp4,audio/webm,audio/wav,audio/ogg,audio/x-m4a

# --- Soft delete retencia ---
SOFT_DELETE_RETENTION_DAYS=90

# --- OpenAI (Whisper STT) ---
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# --- Anthropic (Claude — analýza, sumarizácia, outputs) ---
ANTHROPIC_API_KEY=
# Default = najlepší pomer kvalita/cena. Pre kritické analýzy môžeš prepnúť na Opus.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- JWT auth ---
# Náhodný 32+ znakový reťazec, INÝ než APP_SECRET_KEY.
JWT_SECRET_KEY=
JWT_ACCESS_TTL_SECONDS=900                   # 15 min
JWT_REFRESH_TTL_SECONDS=2592000              # 30 dní

# --- CORS (comma-separated allowed origins) ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000

# --- Worker (arq) ---
WORKER_MAX_JOBS=4
WORKER_JOB_TIMEOUT_SECONDS=600

# --- Embeddings (model + dimenzia musia sedieť s migráciou) ---
EMBEDDING_PROVIDER=openai                    # openai | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
